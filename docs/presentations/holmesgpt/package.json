{
  "name": "labstack-holmesgpt-talk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "slidev --port 3030",
    "dev:en": "slidev slides_en.md --port 3031",
    "build": "slidev build",
    "build:en": "slidev build slides_en.md --out dist_en",
    "export": "slidev export --output holmesgpt.pdf",
    "export:en": "slidev export slides_en.md --output holmesgpt_en.pdf"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@slidev/cli": "53.0.0",
    "playwright-chromium": "1.64.1",
    "slidev-theme-neversink": "0.4.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "katex": "0.18.10",
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
